# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Configurações do projeto > API, em supabase.com/dashboard).
# Sem essas variáveis, o site continua funcionando normalmente com os dados padrão,
# mas o painel /admin fica somente leitura (não dá para criar/editar/remover produtos).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha esta chave no navegador — ela só é usada nas rotas de API do /admin.
SUPABASE_SERVICE_ROLE_KEY=

# Senha para entrar em /admin. Defina um valor forte antes de publicar o site.
ADMIN_PASSWORD=

# Opcional: URL pública do site, usada nas tags de Open Graph/Twitter (ex: https://estilo-da-ilha.vercel.app).
# Se não definir, o site detecta automaticamente a URL da Vercel.
NEXT_PUBLIC_SITE_URL=
